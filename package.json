{
  "name": "carmen-inventory-frontend-e2e",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright end-to-end tests for carmen-inventory-frontend",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:login": "playwright test --project=login",
    "test:chromium": "playwright test --project=chromium",
    "test:unit": "vitest run",

    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:debug": "playwright test --debug",
    "e2e:login": "playwright test --project=login",
    "e2e:chromium": "playwright test --project=chromium",
    "e2e:report": "playwright show-report",
    "e2e:sync": "bun run scripts/sync-test-results.ts",
    "e2e:sync:reset": "bun run scripts/sync-test-results.ts --reset",

    "e2e_win": "node node_modules/@playwright/test/cli.js test",
    "e2e_win:ui": "node node_modules/@playwright/test/cli.js test --ui",
    "e2e_win:headed": "node node_modules/@playwright/test/cli.js test --headed",
    "e2e_win:debug": "node node_modules/@playwright/test/cli.js test --debug",
    "e2e_win:login": "node node_modules/@playwright/test/cli.js test --project=login",
    "e2e_win:chromium": "node node_modules/@playwright/test/cli.js test --project=chromium",
    "e2e_win:report": "node node_modules/@playwright/test/cli.js show-report",
    "e2e_win:sync": "bun run scripts/sync-test-results.ts",
    "e2e_win:sync:reset": "bun run scripts/sync-test-results.ts --reset",

    "docs:user-stories": "bun run scripts/generate-user-stories.ts",
    "report": "playwright show-report",
    "codegen": "playwright codegen http://localhost:3000",
    "install-browsers": "playwright install --with-deps",
    "audit:tc-ids": "bun run scripts/audit-tc-ids.ts",
    "audit:tc-ids:legacy": "bun run scripts/audit-tc-ids.ts --legacy-mode",
    "migrate:tc-propose": "bun run scripts/migrate-tc-ids/propose.ts",
    "migrate:tc-apply": "bun run scripts/migrate-tc-ids/apply.ts",
    "migrate:tc-sheet": "bun run scripts/migrate-tc-ids/sync-sheet.ts",

    "wiki:seed": "bun run tests/wiki-screenshots/seed-manifest.ts",
    "wiki:coverage": "bun run tests/wiki-screenshots/coverage.ts",
    "wiki:capture": "playwright test --project=wiki-screenshots"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^20.19.0",
    "googleapis": "^171.4.0",
    "lefthook": "^2.1.6",
    "typescript": "^5.6.3",
    "vitest": "^4.1.5"
  }
}
